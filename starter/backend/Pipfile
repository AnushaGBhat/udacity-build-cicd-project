[[source]]
url = "https://pypi.org/simple"
verify_ssl = true
name = "pypi"

[packages]
flask = "*"
gunicorn = "*"
flask-cors = "*"
pytest = "*"

[dev-packages]
black = "*"
flake8 = "*"
coverage = "*"

[requires]
python_version = "3.10"

[scripts]
serve = "gunicorn --bind 0.0.0.0:5000 --chdir .. backend:app"
test = "pytest -v"
lint = "flake8"
report = "coverage run -m pytest -v"
lint-fail = "flake8 --max-line-length=88"